# Copy this file to .env and fill in the values. Don't commit .env.

NODE_ENV=development
PORT=4000

# Frontend URLs allowed to call the API (comma separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# MongoDB Atlas - replace <db_password> with the password for the "Cezary" user
# (URL-encode special characters, e.g. @ -> %40)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority&appName=CheckMate
MONGODB_DB_NAME=checkmate

# Key for the /api/dev endpoints (X-Admin-Key header). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=replace-with-a-long-random-string

# Reminders: days before the deadline (0 = on the day)
REMINDER_DAYS_BEFORE=30,14,7,1,0
# Overdue alerts: sent the day after a deadline, then every OVERDUE_REPEAT_DAYS (0 = only once)
OVERDUE_ALERTS=true
OVERDUE_REPEAT_DAYS=7
# Failed NCT: remind to book a retest every NCT_RETEST_REPEAT_DAYS (0 = only once).
# NCT_RETEST_WINDOW_DAYS is how long you have to get the retest done.
NCT_RETEST_REMINDERS=true
NCT_RETEST_REPEAT_DAYS=7
NCT_RETEST_WINDOW_DAYS=30
REMINDER_CRON=0 9 * * *
RETRY_CRON=*/30 * * * *
CRON_ENABLED=true
MAX_DELIVERY_ATTEMPTS=3
RETRY_BASE_MINUTES=15

# true = messages are only logged, nothing is sent
DRY_RUN=true

# Resend (email). EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Twilio (SMS). From number in +353... format.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# error | warn | info | debug | silent
LOG_LEVEL=info
